# Copy this file to .env and fill in your own keys.
# .env is gitignored — never commit real secrets.
#
# Everything here can ALSO be set from inside the app (Settings screen), which
# is the recommended path for day-to-day use. .env is only the first-run
# fallback and is handy for local development / testing.

# Required for real AI-generated ad copy (headlines/captions/CTAs/hashtags).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional override — a sensible default is used if omitted.
# Where finished advertisements are written. Defaults to ~/Documents/DJA Ad Studio/Exports.
DJA_OUTPUT_FOLDER=

# Local dev server port for the Next.js renderer.
PORT=3131
